# Postgres connection string (e.g. from Neon, Supabase, Railway or Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ujuzilink"

# Auth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps JavaScript API key (enable "Maps JavaScript API"; restrict to your domain)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# File uploads. If set, photos go to Vercel Blob; if empty they are saved to .uploads/ on disk (local dev only)
BLOB_READ_WRITE_TOKEN=""

# Teacher subscription
SUBSCRIPTION_PRICE_KES="500"
FREE_TRIAL_DAYS="30"

# M-Pesa Daraja (STK push). Use "sandbox" until Safaricom approves your Go-Live.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
# Must be a public https URL, e.g. https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=""
# Shared secret appended to the callback URL as ?token=... so only Safaricom's call is accepted
MPESA_CALLBACK_TOKEN="change-me"
