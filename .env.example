# Postgres connection string (e.g. from Neon, Supabase, Railway or Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ujuzilink"

# Auth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google Maps JavaScript API key (enable "Maps JavaScript API"; restrict it to your domain). Read at runtime.
GOOGLE_MAPS_API_KEY=""

# File uploads. Photos are saved to UPLOAD_DIR on disk (on RumptyCloud: a persistent disk mounted at /data).
UPLOAD_DIR=".uploads"
# Optional: set this instead to store photos in Vercel Blob (when hosting on Vercel)
BLOB_READ_WRITE_TOKEN=""

# Teacher subscription
SUBSCRIPTION_PRICE_KES="500"
FREE_TRIAL_DAYS="30"

# M-Pesa Daraja (STK push). Use "sandbox" until Safaricom approves your Go-Live.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
# Must be a public https URL, e.g. https://your-domain/api/mpesa/callback
MPESA_CALLBACK_URL=""
# Shared secret appended to the callback URL as ?token=... so only Safaricom's call is accepted
MPESA_CALLBACK_TOKEN="change-me"
